# MiniMax API (Chat Completions compatible)
# Base 必须含 /v1，否则实际请求会变成 https://api.minimaxi.com/chat/completions → 404
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M2.7

# Agent config
SSE_PORT=33338
WORKSPACE_DIR=/root/vibex-workbench
# 默认 = $WORKSPACE_DIR/skills（仓库根 skills/）。覆盖示例：SKILLS_DIR=/root/.hermes/skills
# SKILLS_DIR=
